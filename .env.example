# ============================================
# Transcript Workflow Toolkit — Environment
# ============================================
# Copy this to apps/web/.env.local

# ---- AI Provider (DeepSeek) ----
# Get your API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# ---- YouTube (optional — falls back to yt-dlp) ----
# Get from https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Sentry (optional) ----
# Get DSN from https://sentry.io → Create Project → Next.js
NEXT_PUBLIC_SENTRY_DSN=

# ---- Rate Limiting ----
RATE_LIMIT_TRANSCRIPT_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=30
